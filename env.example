# Twitch App Credentials
# Erstelle eine App unter https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=dein_client_id_hier
TWITCH_CLIENT_SECRET=dein_client_secret_hier

# Der Twitch-Kanal, den du überwachen möchtest (Benutzername, klein geschrieben)
TWITCH_CHANNEL_LOGIN=dein_kanalname_hier

# Port für den lokalen Server (Browser Source URL: http://localhost:3000)
PORT=3000
